# ==============================================================================
# SimTrace — ROOT environment template
# ==============================================================================
# Copy to ".env" and fill in values:   cp .env.example .env
# NEVER commit the real .env (it is gitignored).
#
# This ROOT file serves TWO consumers:
#   1. The Next.js FRONTEND build  → the NEXT_PUBLIC_* vars below
#   2. docker-compose orchestration → every other var below (compose reads .env
#      automatically and injects these into the backend/mongo/redis services)
#
# It does NOT configure the backend when you run it as a standalone Node app
# (e.g. on Render). For that, see  backend/.env.example  (MONGO_URI, REDIS_URL,
# JWT_SECRET, etc.). Keep the shared secrets (JWT_SECRET, API keys) consistent
# between this file and the backend's own env.
#
# PRODUCTION: there is no separate prod template — use these same variables with
# production values, set in your Render (backend) and Vercel (frontend) dashboards.
# ==============================================================================


# ── FRONTEND (Next.js) ────────────────────────────────────────────────────────
# These are baked into the build at BUILD TIME and are publicly visible in the
# browser, so only ever put non-secret, public values here.
# On Vercel: set these in Project → Settings → Environment Variables (all scopes)
# and REDEPLOY — changing them without a rebuild has no effect.

# Base URL of the backend API. NO trailing slash. Must be HTTPS in production.
#   local:      http://localhost:5000        (match backend PORT)
#   production: https://simtrace-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Socket.IO server URL (usually the same origin as the API). NO trailing slash.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Stripe publishable key (safe to expose). pk_test_... in dev, pk_live_... in prod.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Web Push VAPID public key (safe to expose). Pair with the private key on the backend.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=


# ── DATABASE (docker-compose mongo service) ───────────────────────────────────
# Used by docker-compose to provision the Mongo container's root user.
# (The standalone backend instead uses MONGO_URI in backend/.env.example.)
MONGO_ROOT_USER=simtrace
MONGO_ROOT_PASS=change_this_strong_password


# ── AUTH / CORE SECRETS (shared) ──────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST be a strong random value in production — never ship the placeholder.
JWT_SECRET=

ANTHROPIC_API_KEY=sk-ant-...


# ── BACKEND SERVER (docker-compose backend service) ───────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated, NO trailing slashes. Must include the real site origin(s) in prod,
# e.g. https://www.simtrace.site,https://simtrace.site
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
# Set "true" to reject device pings that lack a valid X-Device-Key header.
TRACK_REQUIRE_AUTH=false


# ── M-PESA (Safaricom Daraja) ─────────────────────────────────────────────────
MPESA_ENV=sandbox                 # "sandbox" or "production"
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379            # your Paybill / till number
MPESA_PASSKEY=
# Sandbox credentials: https://developer.safaricom.co.ke


# ── STRIPE ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from: stripe listen --print-secret


# ── EMAIL (SendGrid) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG...
FROM_EMAIL=alerts@simtrace.site


# ── SMS (Africa's Talking) ────────────────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=SimTrace


# ── ERROR MONITORING (Sentry) ─────────────────────────────────────────────────
# SENTRY_DSN is interpolated by docker-compose into the backend service.
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_ORG=
SENTRY_PROJECT=
