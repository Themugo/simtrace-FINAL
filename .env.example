# SimTrace environment variables
# Copy this file to .env and fill in your values
# Never commit .env to git

# ── Required ─────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=simtrace
MONGO_ROOT_PASS=change_this_strong_password

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

ANTHROPIC_API_KEY=

# ── Backend server ────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Set to "true" to reject pings without a valid X-Device-Key header
TRACK_REQUIRE_AUTH=false

# ── Africa's Talking SMS ──────────────────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=SimTrace

# ── SendGrid email ────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
FROM_EMAIL=alerts@simtrace.site

# ── M-Pesa Daraja ─────────────────────────────────────────────────────────────
MPESA_ENV=sandbox         # "sandbox" or "production"
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379    # Your Paybill number
MPESA_PASSKEY=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=    # Get from: stripe listen --print-secret

# Frontend URL (used in password reset emails)
FRONTEND_URL=https://simtrace.site

# Stripe publishable key (safe to expose in frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
