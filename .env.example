# SimTrace Enterprise Platform - Master Environment Variables Example

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_URL=https://simtrace.enterprise.gov

# Database & Cache Connection Strings
DATABASE_URL=postgres://simtrace_admin:STRONG_PASSWORD_HERE@pg-cluster.internal:5432/simtrace_prod
REDIS_URL=redis://:STRONG_REDIS_AUTH@redis-cluster.internal:6379

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
SESSION_SECRET=super_secret_session_key
ENCRYPTION_KEY_32_BYTE=0123456789abcdef0123456789abcdef

# Third-Party & Payment Gateways
STRIPE_SECRET_KEY=sk_live_sample_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_sample_webhook_secret
MPESA_CONSUMER_KEY=mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=mpesa_consumer_secret_here
MPESA_PASSKEY=mpesa_passkey_here
MPESA_SHORTCODE=600000

# AWS S3 Document Storage
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=AKIAEXAMPLEKEY
AWS_SECRET_ACCESS_KEY=secret_access_key_example
AWS_S3_EVIDENCE_BUCKET=simtrace-sovereign-evidence-prod

# Observability & Monitoring
SENTRY_DSN=https://example@sentry.io/123456
PROMETHEUS_METRICS_ENABLED=true
