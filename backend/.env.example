# ─────────────────────────────────────────────────────────────
# SimTrace backend environment template — copy to .env and fill in.
# Never commit a real .env. Required vars must be set for the server
# to boot and the core platform (auth, devices, IMEI, tracking,
# billing, alerts) to function.
# ─────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Mongo connection string. Code reads MONGO_URI (MONGODB_URI also honored).
MONGO_URI=mongodb://localhost:27017/simtrace
# Long random secret used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
API_URL=http://localhost:5000
# Set to "true" to require auth on device-tracking ping ingestion.
TRACK_REQUIRE_AUTH=true
# 32-byte key for at-rest field encryption.
ENCRYPTION_KEY=change-me-32-byte-key
SECRET_ENCRYPTION_KEY=change-me-32-byte-key

# ── Redis (required for rate limiting / queues) ──────────────
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ── AI risk reports (required for /api/ai*) ──────────────────
ANTHROPIC_API_KEY=

# ── Payments (required for /api/billing) ─────────────────────
# M-Pesa (Safaricom Daraja)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Notifications ────────────────────────────────────────────
# Africa's Talking (SMS)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Email
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@simtrace.example

# ── Observability (optional) ─────────────────────────────────
SENTRY_DSN=
CSP_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Optional — only needed if the matching quarantined feature is
# re-enabled (these modules are not mounted in the current build).
# ─────────────────────────────────────────────────────────────
# PayPal
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# Blockchain ledger
# BLOCKCHAIN_NETWORK=
# BLOCKCHAIN_CHAIN_ID=
# BLOCKCHAIN_CONTRACT_ADDRESS=
# Partner marketplace listings
# EBAY_API_KEY=
# JIJI_API_KEY=
# FACEBOOK_API_KEY=

# ── Demo seed (npm run seed) — dev/staging only ──────────────
# The seed refuses to run when NODE_ENV=production unless SEED_ALLOW_PRODUCTION=true.
# If a password is unset, the seed generates a strong random one and prints it once.
# SEED_ADMIN_PASSWORD=
# SEED_SUPERADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=
# SEED_TELECOM_PASSWORD=
# SEED_LAW_PASSWORD=
# SEED_SUPERADMIN_EMAIL=owner@example.com
# SEED_ALLOW_PRODUCTION=false
