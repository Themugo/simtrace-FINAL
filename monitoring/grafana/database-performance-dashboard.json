{
  "dashboard": {
    "title": "SimTrace Database Performance",
    "uid": "simtrace-database-performance",
    "tags": ["simtrace", "database", "mongodb"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Database Operation Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(db_operation_duration_seconds_count[5m])",
            "legendFormat": "{{operation}}"
          }
        ],
        "yaxes": [
          {
            "format": "ops"
          }
        ]
      },
      {
        "id": 2,
        "title": "Database Operation Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(db_operation_duration_seconds_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(db_operation_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(db_operation_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "yaxes": [
          {
            "format": "s"
          }
        ]
      },
      {
        "id": 3,
        "title": "Slow Queries (> 100ms)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(db_operation_duration_seconds_bucket{le=\"0.1\"}[5m])",
            "legendFormat": "Slow Queries"
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [10],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "High Slow Query Rate",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 4,
        "title": "Database Connection Pool",
        "type": "graph",
        "targets": [
          {
            "expr": "db_pool_connections_active",
            "legendFormat": "Active"
          },
          {
            "expr": "db_pool_connections_idle",
            "legendFormat": "Idle"
          },
          {
            "expr": "db_pool_connections_total",
            "legendFormat": "Total"
          }
        ]
      },
      {
        "id": 5,
        "title": "Database Operations by Collection",
        "type": "graph",
        "targets": [
          {
            "expr": "sum by (collection) (rate(db_operation_duration_seconds_count[5m]))",
            "legendFormat": "{{collection}}"
          }
        ]
      },
      {
        "id": 6,
        "title": "Database Errors",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(db_operation_errors_total[5m])",
            "legendFormat": "Errors/sec"
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [5],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "High Database Error Rate",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 7,
        "title": "Index Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "db_index_hit_ratio",
            "legendFormat": "Index Hit Ratio %"
          }
        ],
        "yaxes": [
          {
            "format": "percent"
          }
        ]
      },
      {
        "id": 8,
        "title": "Collection Sizes",
        "type": "table",
        "targets": [
          {
            "expr": "db_collection_size_bytes",
            "legendFormat": "{{collection}}"
          }
        ],
        "transformations": [
          {
            "type": "sort by",
            "field": "Value"
          }
        ]
      }
    ]
  }
}
