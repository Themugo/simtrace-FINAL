# Production Environment Variables Template
# Copy this file to .env.production and fill in the actual values
# DO NOT commit the actual .env.production file with real secrets

# ============================================
# DATABASE
# ============================================
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/simtrace
REDIS_URL=redis://username:password@host:port

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=<32+ character random hex string>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ============================================
# API KEYS
# ============================================
ANTHROPIC_API_KEY=sk-ant-...
# Get from: https://console.anthropic.com/

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=4000
ALLOWED_ORIGINS=https://simtrace-final.vercel.app,https://www.simtrace.site
FRONTEND_URL=https://www.simtrace.site
BACKEND_URL=https://simtrace-backend.onrender.com

# ============================================
# TRACKING
# ============================================
TRACK_REQUIRE_AUTH=true

# ============================================
# M-PESA (Safaricom Daraja)
# ============================================
MPESA_ENV=production
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
# Get from: https://developer.safaricom.co.ke

# ============================================
# STRIPE
# ============================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Get from: https://dashboard.stripe.com

# ============================================
# EMAIL (SendGrid)
# ============================================
SENDGRID_API_KEY=SG...
FROM_EMAIL=alerts@simtrace.site
# Get from: https://sendgrid.com

# ============================================
# SMS (Africa's Talking)
# ============================================
AT_API_KEY=your_api_key
AT_USERNAME=your_username
# Get from: https://africastalking.com

# ============================================
# SENTRY MONITORING
# ============================================
SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ENV=production
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
# Get from: https://sentry.io

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================
NEXT_PUBLIC_API_URL=https://simtrace-backend.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://simtrace-backend.onrender.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
