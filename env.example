# SimTrace Environment Variables Template
# Copy this file to .env and fill in the required values

# ============================================
# DATABASE
# ============================================
MONGO_ROOT_USER=simtrace
MONGO_ROOT_PASS=your_secure_password_here

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# ============================================
# API KEYS
# ============================================
ANTHROPIC_API_KEY=sk-ant-...
# Get from: https://console.anthropic.com/

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
TRACK_REQUIRE_AUTH=false

# ============================================
# M-PESA (Safaricom Daraja)
# ============================================
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Get sandbox credentials from: https://developer.safaricom.co.ke

# ============================================
# STRIPE
# ============================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Get from: https://dashboard.stripe.com

# ============================================
# EMAIL (SendGrid)
# ============================================
SENDGRID_API_KEY=SG...
FROM_EMAIL=alerts@simtrace.site
# Get from: https://sendgrid.com

# ============================================
# SMS (Africa's Talking)
# ============================================
AT_API_KEY=your_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=SimTrace
# Get from: https://africastalking.com

# ============================================
# SENTRY MONITORING
# ============================================
SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ENV=development
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
# Get from: https://sentry.io
